{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mrd-bdsmetro/openbtob",
  "title": "OpenBtoB",
  "description": "Trade data with citations: buyers, suppliers, sanctions screening, HS codes and duty by trade route.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/Nomad-nth/openbtob-mcp",
    "source": "github"
  },
  "websiteUrl": "https://openbtob.com/mcp",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.openbtob.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <API key>: create the key at https://openbtob.com/settings",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": [
        "search_buyers",
        "search_suppliers",
        "get_company",
        "get_tariff_exposure",
        "screen_buyer",
        "watch",
        "unwatch",
        "get_watchlist",
        "lookup_hs",
        "export_data"
      ]
    }
  }
}
